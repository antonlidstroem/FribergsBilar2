@model Fribergs.Core.ViewModels.CarViewModel

@if (!ViewData.ModelState.IsValid)
{
	<div class="alert alert-danger">
		<strong>Formuläret är ogiltigt.</strong> Kontrollera alla fält.
	</div>
}

<h1 class="page-title">REDIGERA BIL</h1>

@*<form asp-action="Edit" method="post">*@
<form asp-action="Edit">

	<input type="hidden" asp-for="CarId" />

	<div asp-validation-summary="ModelOnly" class="text-danger"></div>


	<div class="form-group">
		<label asp-for="Brand"></label>
		<input asp-for="Brand" class="form-control" />
		@* <span asp-validation-for="Brand" class="text-danger"></span> *@
	</div>

	<div class="form-group">
		<label asp-for="Model"></label>
		<input asp-for="Model" class="form-control" />
		@* <span asp-validation-for="Model" class="text-danger"></span> *@
	</div>

	<div class="form-group">
		<label asp-for="Year"></label>
		<input asp-for="Year" class="form-control" />
		@* <span asp-validation-for="Year" class="text-danger"></span> *@
	</div>

	<div class="form-group">
		<label asp-for="PricePerDay"></label>
		<input asp-for="PricePerDay" class="form-control" />
		@* <span asp-validation-for="PricePerDay" class="text-danger"></span> *@
	</div>

	<div class="form-group">
		<label asp-for="CarDescription"></label>
		<textarea asp-for="CarDescription" class="form-control" rows="4"></textarea>
		@* <span asp-validation-for="CarDescription" class="text-danger"></span> *@
	</div>

	<div class="form-group">
		<label>Bilder</label>

		@* Existerande bilder *@
		@for (int i = 0; i < Model.ImageUrls.Count; i++)
		{
			<div class="mb-2">
				<input type="text"
					   name="ImageUrls[@i]"
					   value="@Model.ImageUrls[i]"
					   class="form-control"
					   placeholder="Bildlänk..." />
			</div>
		}

		@* Extra tomma fält för nya bilder 
        @for (int i = Model.ImageUrls.Count; i < Model.ImageUrls.Count + 3; i++)
        {
            <div class="mb-2">
                <input type="text"
                       name="ImageUrls[@i]"
                       class="form-control"
                       placeholder="Ny bildlänk..." />
            </div>
        } *@




	</div>

	<div class="form-group form-check">
		<input asp-for="Available" class="form-check-input" />
		<label asp-for="Available" class="form-check-label">Bilen är tillgänglig för uthyrning</label>
	</div>

	<input type="submit" class="btn btn-primary">Spara</input>
	<a asp-action="Index" class="btn btn-secondary">Avbryt</a>
</form>

@section Scripts {
	@await Html.PartialAsync("_ValidationScriptsPartial")
}
